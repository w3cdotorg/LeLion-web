; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="LeLion"
config/version="0.20"
run/main_scene="res://Scenes/Titre.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"

[autoload]

GameState="*res://Scripts/GameState.gd"
Scores="*res://Scripts/Scores.gd"
Parametres="*res://Scripts/Parametres.gd"
Audio="*res://Scripts/Audio.gd"
Reseau="*res://Scripts/Reseau.gd"
Decouverte="*res://Scripts/Decouverte.gd"

[display]

window/size/viewport_width=2000
window/size/window_width_override=1400
window/size/window_height_override=454
window/stretch/mode="viewport"

[internationalization]

locale/translations=PackedStringArray("res://Assets/Traductions/traductions.en.translation", "res://Assets/Traductions/traductions.fr.translation")
locale/fallback="en"

